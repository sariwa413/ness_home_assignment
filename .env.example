# Copy to .env and edit. Every value is optional: anything left out falls back to the
# active profile in config/config.yaml. Real environment variables override this file,
# so `$env:ENV="local"` still wins for a single run.
#
#   Copy-Item .env.example .env
#
# .env is git-ignored, which is why credentials belong here and not in config.yaml.

# --- what to run ------------------------------------------------------------
# Profile from config/config.yaml: default | local | ci
ENV=default

# --- browser ----------------------------------------------------------------
# chromium | firefox | webkit
BROWSER=chromium
# false shows the window, which eBay challenges less often
HEADLESS=true
# Milliseconds to pause between actions; useful when watching a headed run
SLOW_MO_MS=0
# Per-action timeout
TIMEOUT_MS=30000

# --- site -------------------------------------------------------------------
BASE_URL=https://www.ebay.com
CART_URL=https://cart.ebay.com
LOCALE=en-US
# The default headless user agent trips eBay's bot challenge; keep a real desktop one
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36

# --- resilience -------------------------------------------------------------
# Reloads when eBay answers with its error or bot-challenge page
NAVIGATION_RETRIES=4
# Fixes the "random" variant selection so a run can be reproduced
RANDOM_SEED=1234

# --- output -----------------------------------------------------------------
ARTIFACTS_DIR=artifacts

# --- authentication ---------------------------------------------------------
# guest runs without signing in, which is the default because eBay guards the real
# sign-in with a bot challenge. Use credentials to drive the actual form.
AUTH_MODE=guest
EBAY_USERNAME=
EBAY_PASSWORD=
